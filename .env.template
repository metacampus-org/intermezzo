# Campus DAO operator config. Each operator runs their own intermezzo
# middleware under a metaCAMPUS-DAO license for higher ed. Not a fork.
# Copy this file to .env before running. CI does that itself.

NODE_ENV=development

# Transit engine path values for the different roles
VAULT_TRANSIT_USERS_PATH=pawn/users
VAULT_TRANSIT_MANAGERS_PATH=pawn/managers

# Custom secrets engine (vault/plugin) for Algorand post-quantum
# (Falcon-1024) user accounts. Mounted by vault/development-init.ts.
VAULT_PQ_USERS_PATH=pawn/pq-users

# Default vault user
VAULT_MANAGER_KEY=manager

# Usually docker network domain
# Change if you are using a different network or want to connect to a remote vault
VAULT_BASE_URL=http://vault:8200
VAULT_LOCAL_URL=http://localhost:8200
# Per campus DAO operator. A licensed higher-ed deployment sets its own
# Vault namespace here so it stays separate from financial infrastructure.
# Example: metcampus-dao
VAULT_NAMESPACE=

# DEFAULT ROLE ID and SECRET ID for the user to access the vault
# REPLACE WITH YOUR OWN VALUES
VAULT_ROLE_ID=someRoleID
VAULT_SECRET_ID=someUserId

# Uses local instance of vault
CLI_USE_LOCAL_VAULT=true

# Network. Localnet is the default (AlgoKit sandbox and CI).
# For Testnet, comment the Localnet block and uncomment the Testnet block.
# Localnet (algokit sandbox) values
GENESIS_ID=dockernet-v1
GENESIS_HASH=MU03J7aP42QIzRUjiNuSKPPxyv108uGZlA3nFFtC3fk=
# Algod sandbox values
# Defaults target the host (e2e tests run on host). Inside the pawn container,
# docker-compose overrides NODE_HOST/NODE_PORT to reach the sandbox via its docker network.
NODE_HTTP_SCHEME=http
NODE_PORT=4001
NODE_HOST=localhost
NODE_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Testnet (AlgoNode)
# GENESIS_ID=testnet-v1.0
# GENESIS_HASH=SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
# NODE_HTTP_SCHEME=https
# NODE_PORT=443
# NODE_HOST=testnet-api.algonode.cloud
# NODE_TOKEN=

JWT_SECRET='DO NOT USE THIS VALUE'